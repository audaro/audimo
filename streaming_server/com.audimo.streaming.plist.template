<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<!--
  launchd agent template for the bundled audimo streaming server
  (libtorrent sidecar, port 11471).

  Do NOT install this file directly — paths are placeholders. Render
  + install with `scripts/install_launchd.sh` from the repo root.

  In a packaged build the desktop app spawns this as a Tauri sidecar
  (see frontend/src-tauri/src/sidecars.rs). This plist is for dev /
  to satisfy :11471 when running an older Audimo.app build that
  pre-dates the bundled streaming server.

  Logs: tail -f $HOME/.audimo/streaming/audimo-streaming.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.audimo.streaming</string>

    <key>ProgramArguments</key>
    <array>
        <string>__REPO_ROOT__/streaming_server/run_native.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO_ROOT__/streaming_server</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.audimo/streaming/audimo-streaming.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.audimo/streaming/audimo-streaming.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
